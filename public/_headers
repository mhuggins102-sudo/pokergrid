# Cloudflare Pages reads this file from the build output and applies
# the rules to matching paths.

# build-version.json must never be cached — otherwise stale PWAs would
# never detect that a newer build has landed.
/build-version.json
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

# index.html must revalidate on every navigation. Without this, an
# installed PWA can be pinned to a months-old HTML that references
# months-old JS bundles, and the only escape is a manual
# clear-site-data. The HTML payload is tiny (~2KB) so revalidating
# every load costs nothing while making fresh deploys land on
# next refresh.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
